# ==============================================================================
# OmniLog Monorepo Environment Configuration
# Copy this file to .env or configure server/.env and client/.env individually
# ==============================================================================

# --- Server / REST API Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://xxxxx:xxxxxxxx@cluster0.ryxlm.mongodb.net/xxxxxxxx?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters_long
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=xxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
ADMIN_EMAILS=admin@omnilog.local,your.email@gmail.com

# --- Resend API & Contact Form Settings (React Email) ---
# Obtain your API key from https://resend.com/api-keys
# Leaving as a placeholder activates development simulation mode automatically
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL_TO=your.inbox@example.com
CONTACT_EMAIL_FROM=OmniLog Contact <onboarding@resend.dev>

# --- Client Configuration ---
VITE_API_URL=http://localhost:5000/api
VITE_CONTACT_EMAIL=your.inbox@example.com
